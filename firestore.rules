rules_version = '2';

// Security rules for the Chroma Match leaderboard.
//
// WHAT THESE RULES CAN AND CANNOT DO
//
// They enforce shape: signed in, the right fields, the right types, sane
// bounds, a move list that could plausibly encode a run, and a row that can
// never be edited once written. That stops malformed and abusive writes.
//
// They CANNOT decide whether a score was actually earned. Rules cannot replay a
// match-3 game, so a determined person can post any number within the bounds
// below. That check belongs in a Cloud Function, which needs the Blaze plan;
// until then every client replays the entries it displays and drops the ones
// that do not check out, so a forged row cannot sit at the top of anyone's
// board. Each row already carries its seed and move list, so turning on
// server-side verification later needs no schema change.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnRow() {
      return request.resource.data.uid == request.auth.uid;
    }

    function hasExactFields() {
      return request.resource.data.keys().hasOnly(
        ['uid', 'name', 'score', 'level', 'seed', 'moves', 'board', 'at']
      ) && request.resource.data.keys().hasAll(
        ['uid', 'name', 'score', 'level', 'seed', 'moves', 'board', 'at']
      );
    }

    function profileIsWellFormed() {
      return (!('name' in request.resource.data.keys())
              || (request.resource.data.name is string
                  && request.resource.data.name.size() > 0
                  && request.resource.data.name.size() <= 16))
          && (!('code' in request.resource.data.keys())
              || (request.resource.data.code is string
                  && request.resource.data.code.size() == 7))
          && (!('photo' in request.resource.data.keys())
              || (request.resource.data.photo is string
                  && request.resource.data.photo.size() <= 300))
          // Bounded because the friends board reads them with an `in` query,
          // which Firestore caps at 30 values. A list longer than the cap
          // would be a list whose tail silently never appears on the board.
          && (!('friends' in request.resource.data.keys())
              || (request.resource.data.friends is list
                  && request.resource.data.friends.size() <= 24))
          && (!('best' in request.resource.data.keys()) || bestIsWellFormed());
    }

    // The player's best run, stored so a friends board can be read in one
    // query. Same shape as a /runs row and bounded the same way — and, like a
    // /runs row, these rules cannot tell whether it was earned. The viewer
    // replays it before it reaches the board; this only stops it being junk.
    function bestIsWellFormed() {
      return request.resource.data.best.keys().hasOnly(
               ['seed', 'moves', 'score', 'level', 'board', 'at']
             )
          && request.resource.data.best.score is int
          && request.resource.data.best.score >= 0
          && request.resource.data.best.score <= 10000000
          && request.resource.data.best.level is int
          && request.resource.data.best.level >= 1
          && request.resource.data.best.level <= 999
          && request.resource.data.best.seed is int
          && request.resource.data.best.seed >= 0
          && request.resource.data.best.seed <= 4294967295
          && request.resource.data.best.moves is string
          && request.resource.data.best.moves.size() > 0
          && request.resource.data.best.moves.size() <= 8000
          && request.resource.data.best.moves.matches('^[0-9a-z]+$')
          && request.resource.data.best.board.keys().hasOnly(['cols', 'rows', 'kinds']);
    }

    function scoresAreSane() {
      return request.resource.data.score is int
          && request.resource.data.score >= 0
          // Far above anything the tuning sweep produces, but finite: an
          // unbounded score would sit at the top of the board forever.
          && request.resource.data.score <= 10000000
          && request.resource.data.level is int
          && request.resource.data.level >= 1
          && request.resource.data.level <= 999;
    }

    function runIsWellFormed() {
      return request.resource.data.seed is int
          && request.resource.data.seed >= 0
          && request.resource.data.seed <= 4294967295
          && request.resource.data.moves is string
          // Two base36 characters per action — a swap, or an item spent on a
          // cell — so this caps a run at 4000 actions, matching MAX_MOVES in
          // src/game/replay.ts. Items were added inside the existing encoding
          // rather than beside it, so this bound did not have to move: a run
          // that used items is the same shape as one that did not.
          && request.resource.data.moves.size() > 0
          && request.resource.data.moves.size() <= 8000
          && request.resource.data.moves.matches('^[0-9a-z]+$')
          && request.resource.data.board.keys().hasOnly(['cols', 'rows', 'kinds'])
          && request.resource.data.board.cols is int
          && request.resource.data.board.rows is int
          && request.resource.data.board.kinds is int;
    }

    function nameIsReasonable() {
      return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 16;
    }

    function stampedNow() {
      // The server's clock, not the client's, so a row cannot be backdated to
      // sort ahead of an equal score that was posted first.
      return request.resource.data.at == request.time;
    }

    match /runs/{runId} {
      // The board is public; anyone can read it, signed in or not.
      allow read: if true;

      allow create: if isSignedIn()
                    && isOwnRow()
                    && hasExactFields()
                    && scoresAreSane()
                    && runIsWellFormed()
                    && nameIsReasonable()
                    && stampedNow();

      // A posted run is a historical record. Nothing edits or deletes it —
      // including its author, so a score cannot be quietly revised upward.
      allow update, delete: if false;
    }

    // ---- players -------------------------------------------------------
    //
    // Identity only: a name, a friend code, a picture, and the uids this
    // player follows. Deliberately no scores. A friends board is built by
    // reading the same /runs rows the public board reads and replaying them,
    // so a friend's number is checked exactly the way a stranger's is; a
    // `best` field cached here would be the one score on the screen that
    // nobody verified.
    match /players/{playerId} {
      // Readable by anyone signed in, because adding a friend means looking a
      // code up, and following one means reading their profile. Not public:
      // unlike a leaderboard row, this is a directory of accounts.
      allow read: if isSignedIn();

      // Written only by its owner, and only ever to their own path — which is
      // what makes a one-directional friends list expressible as a rule. A
      // mutual graph would need each side to write the other's document, and
      // no rule can tell a friend request from a stranger editing your list.
      allow create, update: if isSignedIn()
                            && request.auth.uid == playerId
                            && request.resource.data.uid == playerId
                            && request.resource.data.keys().hasOnly(
                                 ['uid', 'name', 'code', 'photo', 'friends', 'best']
                               )
                            && profileIsWellFormed();

      allow delete: if isSignedIn() && request.auth.uid == playerId;
    }

    // Everything else stays closed. This is already the default; it is written
    // out so that adding a collection is a deliberate act.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
