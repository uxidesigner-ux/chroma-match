{
  "name": "chroma-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal match-3 puzzle with a royal lobby, layered obstacles, level editor, and Canvas gameplay.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-royal-sprites.mjs --verify-sources && tsc --noEmit && node --check public/sw.js && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-game.mjs",
    "test:all": "node --test \"src/**/*.test.ts\"",
    "test:game-ui": "playwright test --config playwright.royal.config.ts",
    "test:legacy-game-ui": "playwright test --config playwright.game.config.ts",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "pretest:release": "node scripts/prepare-release-browsers.mjs",
    "test:release": "playwright test --config playwright.royal-release.config.ts",
    "test:legacy-release": "playwright test --config playwright.release.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "sprites:build": "node scripts/build-royal-sprites.mjs",
    "tune": "node scripts/tune-board.ts",
    "test:royal": "playwright test --config playwright.royal.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.5",
    "@types/three": "0.183.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.1",
    "firebase": "^12.19.0",
    "three": "0.183.2"
  }
}
