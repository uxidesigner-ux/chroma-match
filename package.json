{
  "name": "chroma-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A match-3 puzzle game rendered on canvas. No engine, no sprites — every gem is drawn from shape primitives.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node --check public/sw.js && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "tune": "node scripts/tune-board.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.5",
    "@types/three": "0.183.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.1",
    "firebase": "^12.19.0",
    "three": "0.183.2"
  }
}
